# Ejemplo de deploy/.env (lo crea install.sh con sus preguntas; no se sube a git). Los valores van entre comillas simples.
TEIKEM_DOMAIN='teikem.advancelogisticspr.com'
# Correo que recibe los avisos de Let's Encrypt (certificado HTTPS automático, se renueva solo).
TEIKEM_ACME_EMAIL='correo@advancelogisticspr.com'
ConnectionStrings__Teikem='Server=IP-O-NOMBRE,1433;Database=Teikem;User Id=USUARIO;Password=CLAVE;TrustServerCertificate=True;Encrypt=True;MultipleActiveResultSets=True'
# Llave que firma las sesiones: larga y secreta. Si la cambia, todos tienen que volver a entrar.
Jwt__SigningKey='GENERADA-POR-INSTALL.SH'
# Correo (código de verificación del primer ingreso). Sin esto, el primer ingreso no puede enviar el código.
Brevo__ApiKey='xkeysib-...'
Brevo__FromEmail='no-reply@advancelogisticspr.com'
Brevo__FromName='Teikem'
