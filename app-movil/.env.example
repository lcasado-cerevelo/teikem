# Copie este archivo a .env (no se sube) y reinicie con `npx expo start -c`.
# Emulador de Android: el «localhost» del emulador es el propio emulador; la PC se ve como 10.0.2.2.
EXPO_PUBLIC_BASE_URL=http://10.0.2.2:5000/api/
# Celular físico: la IP de la PC en la red (ipconfig), p. ej. http://192.168.1.50:5000/api/ y el API arrancado con ASPNETCORE_URLS=http://0.0.0.0:5000
# Producción:
# EXPO_PUBLIC_BASE_URL=https://api.miempresa.com/api/
