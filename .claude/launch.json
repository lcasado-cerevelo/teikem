{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/Teikem.Api", "--no-launch-profile", "--environment", "Development", "--urls", "https://localhost:5001;http://localhost:5000"],
